{
  // Chequeo de tipos de todo el monorepo en una sola pasada, tests incluidos.
  // Resuelve @mqs/* contra `src` (no contra `dist`) para no exigir un build
  // previo; el build real, con declaraciones y orden topológico, es `tsc -b`.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@mqs/qr-core": ["packages/qr-core/src/index.ts"],
      "@mqs/baneco-gateway": ["packages/baneco-gateway/src/index.ts"],
      "@mqs/firestore-store": ["packages/firestore-store/src/index.ts"],
      "@mqs/composicion": ["packages/composicion/src/index.ts"],
      "@mqs/baneco-satelite": ["packages/baneco-satelite/src/index.ts"],
      "@mqs/yape-scraper": ["packages/yape-scraper/src/index.ts"],
      "@mqs/wa-bridge": ["packages/wa-bridge/src/index.ts"],
      "@mqs/functions": ["packages/functions/src/index.ts"],
      "@mqs/demo-web": ["packages/demo-web/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*", "tools/*/src/**/*", "scripts/**/*", "*.config.ts", "*.config.mjs"],
  "exclude": ["node_modules", "**/dist", "coverage"]
}
