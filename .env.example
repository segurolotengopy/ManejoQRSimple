# ============================================================
#  ManejoQRSimple — plantilla de variables de entorno
#  Copiar a .env y completar.  .env NUNCA se versiona.
#  Documentación: docs/05-firebase-demo.md y docs/06-seguridad.md
# ============================================================

# ── Modo de integración ─────────────────────────────────────
# mock = adaptadores simulados (tests, desarrollo sin banco)
# demo = scraper y WhatsAppModular reales
INTEGRATION_MODE=mock
DEMO_MODE=true

# ── Firebase ────────────────────────────────────────────────
# Verificar el project-id exacto con `firebase projects:list`
FIREBASE_PROJECT_ID=
# Ruta a la llave de la service account del SCRAPER (mínimo privilegio,
# docs/05 §4). Vive fuera del repo, típicamente en ~/.manejoqr/
SCRAPER_FIREBASE_CREDENTIALS_PATH=
# true = usar emuladores locales
FIREBASE_USE_EMULATORS=true

# ── Cobros y QR ─────────────────────────────────────────────
COBRO_MONEDA=BOB
# Vigencia por defecto del QR en horas. El máximo real lo define la billetera:
# verificar en la consola (docs/02 §4) antes de subirlo.
QR_TTL_HORAS=24
# Tolerancia de conciliación: aceptar abonos hasta N minutos después del
# vencimiento del QR (la transferencia puede acreditarse con demora)
CONCILIACION_TOLERANCIA_MINUTOS=30
# Ventana tras COMPROBANTE_RECIBIDO sin abono detectado antes de EN_REVISION
CONCILIACION_VENTANA_HORAS=6

# ── Scraper Yape BCP ────────────────────────────────────────
# URL de la consola: se completa tras el mapeo (docs/03 §6). No inventar.
YAPE_CONSOLE_URL=
# Sesión de Playwright generada con `npm run scraper:login` (permisos 600)
SCRAPER_STORAGE_STATE_PATH=~/.manejoqr/yape-storage-state.json
SCRAPER_POLL_INTERVAL_SECONDS=300
SCRAPER_HEADLESS=true
# true = detecta y loguea, NO escribe a Firestore. Dejar en true en desarrollo.
SCRAPER_DRY_RUN=true

# ── WhatsAppModular (docs/04) ───────────────────────────────
WM_BASE_URL=
WM_API_TOKEN=
WM_TEMPLATE_COBRO=cobro_qr
WM_TEMPLATE_CONFIRMACION=cobro_confirmado
# Secreto HMAC del webhook entrante de comprobantes (32+ chars aleatorios)
WA_INBOUND_HMAC_SECRET=
# Teléfono del dueño para notificaciones operativas (formato E.164)
OWNER_PHONE=

# ── Observabilidad ──────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=manejoqrsimple

# --- Banco Económico (Baneco) — Cobros QR Simple v1.3.0 ---
BANECO_ENV=cert
BANECO_CERT_BASE_URL=
BANECO_CERT_USERNAME=
BANECO_CERT_PASSWORD=
BANECO_CERT_AES_KEY=
BANECO_CERT_ACCOUNT_CREDIT=
# Producción: solo Hito B4, tras certificación formal del banco.
BANECO_PROD_BASE_URL=
BANECO_PROD_USERNAME=
BANECO_PROD_PASSWORD=
BANECO_PROD_AES_KEY=
BANECO_PROD_ACCOUNT_CREDIT=
BANECO_QR_TTL_HORAS=72
BANECO_POLL_INTERVAL_SECONDS=180

# --- Selección de adaptador por puerto (D1: multi-proveedor) ---
QR_PROVIDER=mock
PAYMENT_WATCHER=mock
